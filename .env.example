GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
PORT=3000
# NCKU Smart Commute 本機設定範例
# 複製為 .env 後填入自己的金鑰；請勿把 .env 提交到版本控制。

# ---- 執行模式 ----
# fixture：使用測試資料，不需網路或金鑰；live：呼叫真實服務
PROVIDER_MODE=fixture
APP_ENV=development
TIMEZONE=Asia/Taipei
HTTP_TIMEOUT_SECONDS=8

# ---- Gemini ----
# 擇一填寫即可；GOOGLE_API_KEY 的優先順序高於 GEMINI_API_KEY。
GOOGLE_API_KEY=
GEMINI_API_KEY=
# 使用 AI Studio API key（非 Vertex AI）時維持 FALSE。
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3-flash-preview

# ---- 成大公開服務（通常無須修改） ----
NCKU_GIS_BASE_URL=https://db.nckumap.ncku.edu.tw/nckugis/public
NCKU_PARKING_BASE_URL=https://apss.oga.ncku.edu.tw/park/index.php/park11215

# ---- 課表與預設出發地 ----
CLASS_SCHEDULE_PATH=data/class_schedule.json
USER_SCHEDULE_PATH=data/user_schedule.json
# 可填住家或常用起點；含個人地址，請僅放在自己的 .env。
DEFAULT_ORIGIN=

# 一段自然語言的通勤偏好，交給 Gemini 在各交通方案之間權衡時參考。
# 例如：我怕熱，不想在太陽下走超過 15 分鐘，能不騎機車就不騎。
COMMUTE_PREFERENCE=

# ---- 路線時間 ----
# auto：能免費估算時優先使用；estimate：完全不使用 Google；google：固定使用 Google Routes（可能計費）
TRAVEL_TIME_PROVIDER=auto
GOOGLE_MAPS_API_KEY=

# ---- 選用功能 ----
# 天氣（中央氣象署）
CWA_API_KEY=
# 臺南公車即時資訊（TDX）
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# ---- 本機模型（Gemma via Ollama，選用） ----
# 個資類文字（課表地點）優先在本機判讀；Ollama 沒起來會自動退回雲端 Gemini。
# 安裝：winget install Ollama.Ollama；ollama pull gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma3:4b

# ---- 手機推播（ntfy，選用） ----
# 手機裝 ntfy app（iOS/Android）訂閱同一個 topic 就收得到；topic 名稱等於收件位址，用長隨機字串並當秘密保管。
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
