# ============================================================
# 團隊共用範本：複製成 .env 後只需要改 GEMINI_API_KEY 這一行。
# 其他每一項在程式裡都有預設值，留空或整行刪掉都不會出錯，
# 請不要自行更動，以免大家本機行為對不上。
# .env 已被 .gitignore 排除，絕不 commit、不要用截圖或聊天傳遞。
# ============================================================

# fixture = 讀錄製的真實回應（不需金鑰、離線可跑）；live = 打真實 API
PROVIDER_MODE=fixture
TIMEZONE=Asia/Taipei
HTTP_TIMEOUT_SECONDS=8

# Gemini（AI Studio）：每個人請申請自己的 Key，不要共用同一把
# （AI Studio 免費額度是以帳號為單位，共用會互搶額度、demo 時容易被限流）
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 之後的功能（尚未使用）
CWA_API_KEY=
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
